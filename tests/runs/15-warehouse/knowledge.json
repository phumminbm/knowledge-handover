    {
      "id": "P01",
      "name": "Handle a count discrepancy",
      "summary": "Decide whether to adjust, recount or escalate when a count differs from the WMS",
      "trigger": "A count differs from the WMS quantity",
      "frequency": "Daily",
      "complete": true,
      "coverage": {
        "trigger": "done",
        "steps": "done",
        "inputs_outputs": "done",
        "systems": "done",
        "people": "done",
        "decisions": "done",
        "exceptions": "done",
        "checks": "done",
        "failures": "done",
        "deadlines": "skipped",
        "risk": "done",
        "wish_known": "done"
      },
      "systems": [
        {
          "name": "WMS",
          "purpose": "Stock quantities",
          "source_of_truth": true
        },
        {
          "name": "Known-issues spreadsheet",
          "purpose": "Explains recurring discrepancies",
          "source_of_truth": false
        }
      ],
      "people": [
        {
          "name_or_role": "Warehouse manager",
          "involvement": "Approves large or serialised adjustments"
        },
        {
          "name_or_role": "Licensed forklift driver",
          "involvement": "Counts upper racking"
        }
      ],
      "steps": [
        {
          "id": "P01.S01",
          "title": "Check the value and item type",
          "detail": "Work out the value of the difference; check whether the item is serialised",
          "why": "Policy SOP-WH-12 sets who may adjust",
          "branch_question": "Over 5,000 baht or serialised?",
          "branches": [
            {
              "label": "No — small, not serialised",
              "goto": "P01.S02"
            },
            {
              "label": "Yes",
              "goto": "P01.S03"
            }
          ],
          "who_can_do": "ai_with_approval",
          "who_can_do_confirmed": true,
          "status": "source_supported"
        },
        {
          "id": "P01.S02",
          "title": "Adjust in the WMS with a reason code",
          "detail": "Post the adjustment and note the reason in the known-issues spreadsheet",
          "why": "The spreadsheet explains repeat issues next month",
          "check": "WMS quantity equals the count",
          "who_can_do": "human_only",
          "who_can_do_confirmed": true,
          "status": "employee_provided",
          "next": "P01.S06"
        },
        {
          "id": "P01.S03",
          "title": "Check the putaway log for the last 7 days",
          "detail": "Look for stock put in the wrong location",
          "why": "Most large differences are misplaced, not missing",
          "who_can_do": "ai_with_approval",
          "who_can_do_confirmed": true,
          "status": "employee_provided"
        },
        {
          "id": "P01.S04",
          "title": "Recount (upper racking: forklift driver only)",
          "detail": "Recount the location; upper levels need a licensed driver",
          "why": "Safety and accuracy",
          "safety": true,
          "risk": "high",
          "actor": "Licensed forklift driver",
          "branch_question": "Does the recount match the WMS?",
          "branches": [
            {
              "label": "Yes",
              "goto": "P01.S06"
            },
            {
              "label": "No",
              "goto": "P01.S05"
            }
          ],
          "who_can_do": "human_only",
          "who_can_do_confirmed": true,
          "status": "employee_provided"
        },
        {
          "id": "P01.S05",
          "title": "Tell the warehouse manager",
          "detail": "Send location, SKU, counts and what you checked",
          "why": "Large adjustments need approval (SOP-WH-12)",
          "who_can_do": "ai_with_approval",
          "who_can_do_confirmed": true,
          "status": "source_supported",
          "next": "P01.S06"
        },
        {
          "id": "P01.S06",
          "title": "Close the discrepancy",
          "detail": "Mark it resolved in the spreadsheet",
          "who_can_do": "ai_with_approval",
          "who_can_do_confirmed": true,
          "status": "employee_provided"
        }
      ],
      "rules": [
        {
          "id": "R-001",
          "text": "Differences over 5,000 baht or on serialised items need a recount and the manager's approval",
          "why": "Company policy",
          "status": "source_supported",
          "source": "SOP-WH-12 as quoted by the giver"
        },
        {
          "id": "R-002",
          "text": "The WMS wins for quantities; the spreadsheet only explains",
          "why": "Auditors use the WMS",
          "status": "employee_provided"
        }
      ],
